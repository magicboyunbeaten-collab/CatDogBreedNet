# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# Environment & secrets
.env
.env.*
!.env.example

# Node / frontend
node_modules/
dist/

# Datasets and uploads (never committed)
data/raw/
data/processed/
uploads/

# Databases
*.db
*.sqlite
*.sqlite3

# Training artifacts (generated by training, not pre-committed)
artifacts/*.pth
!artifacts/.gitkeep

# Generated reports (kept: dataset.md and .gitkeep only)
reports/*.csv
reports/*.png
reports/split_*.json
reports/*.log
!reports/.gitkeep
!reports/dataset.md

# Thesis figures & screenshots are binary outputs (kept locally, not committed)
reports/diagrams/
reports/screenshots/

# Local caches and toolchains (kept on E: drive, not committed)
.cache/
tools/

# IDE project data
.codebuddy/
