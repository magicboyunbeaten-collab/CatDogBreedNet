# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# Environment & secrets
.env
.env.*
!.env.example

# Node / frontend
node_modules/
dist/

# Datasets and uploads (never committed)
data/raw/
data/processed/
data/processed_clean/
uploads/

# Databases
*.db
*.sqlite
*.sqlite3

# Training artifacts (generated by training, not pre-committed)
artifacts/*.pth
artifacts/**/*.pth
!artifacts/.gitkeep

# Generated reports (kept: dataset.md and .gitkeep only)
reports/*.csv
reports/*.png
reports/split_*.json

# 近重复联系表图片：由 scripts/review_near_duplicates.py 生成，可随时重建；
# 保留报告（.md/.json/.csv）与人工判定记录（visual_verification.json）
reports/leakage_review/*.png

# 种子验证实验的曲线/混淆矩阵图片：由 ml.evaluate 生成，可随时重建；
# 保留 test_metrics.json、classification_report.csv、train_log.csv 等文本产物
reports/exp_seed_*/*.png

# 早停 patience 对比实验的曲线/混淆矩阵图片（同上，可随时重建）
reports/exp_esp_*/*.png
reports/*.log
!reports/.gitkeep
!reports/dataset.md

# Thesis figures & screenshots are binary outputs (kept locally, not committed)
reports/diagrams/
reports/screenshots/

# Local caches and toolchains (kept on E: drive, not committed)
.cache/
tools/

# IDE project data
.codebuddy/
