# Backend configuration example. Copy to .env (git-ignored) and adjust.
# All variables are optional; the defaults below match local development.

# Model checkpoint and device (auto | cpu | cuda)
CATDOG_WEIGHTS_PATH=artifacts/best_model.pth
CATDOG_DEVICE=auto

# Default Top-K returned by POST /api/predict
CATDOG_DEFAULT_TOP_K=3

# Upload validation
CATDOG_UPLOAD_DIR=uploads
CATDOG_MAX_UPLOAD_MB=10
CATDOG_MAX_IMAGE_PIXELS=25000000
CATDOG_ALLOWED_FORMATS=JPEG,PNG,WEBP

# SQLite database file
CATDOG_DB_PATH=data/app.db

# CORS: comma-separated origins allowed to call the API (dev frontend)
CATDOG_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# History / stats behaviour
CATDOG_HISTORY_PAGE_SIZE=20
CATDOG_HISTORY_MAX_PAGE_SIZE=100
CATDOG_STATS_TOP_BREEDS=10
CATDOG_STATS_TREND_DAYS=14
